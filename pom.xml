<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.exemplo</groupId>
    <artifactId>experimentacao-microservicos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>experimentacao-microservicos</name>

    <modules>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>gateway</module>
        <module>pecas-service</module>
        <module>clientes-service</module>
        <module>representantes-service</module>
        <module>testes-integracao</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <pitest.version>1.30.0</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Teste de mutação (Pitest): altera o código de produção (mutantes)
                    e verifica se os testes unitários detectam cada alteração.
                    Roda sob demanda: mvn org.pitest:pitest-maven:mutationCoverage
                -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>com.exemplo.*</param>
                        </targetClasses>
                        <excludedClasses>
                            <!-- classes main() do Spring Boot não têm lógica a testar -->
                            <param>com.exemplo.*.*Application</param>
                        </excludedClasses>
                        <targetTests>
                            <param>com.exemplo.*</param>
                        </targetTests>
                        <excludedTestClasses>
                            <!-- o teste com contexto completo é lento e não é unitário -->
                            <param>com.exemplo.*.*IntegracaoTest</param>
                        </excludedTestClasses>
                        <mutators>
                            <mutator>STRONGER</mutator>
                        </mutators>
                        <outputFormats>
                            <param>HTML</param>
                            <param>XML</param>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <!-- falha o build se menos de 80% dos mutantes forem mortos -->
                        <mutationThreshold>80</mutationThreshold>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
