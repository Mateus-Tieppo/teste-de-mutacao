<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.exemplo</groupId>
        <artifactId>experimentacao-microservicos</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>testes-integracao</artifactId>
    <description>
        Testes fim a fim (caixa-preta): chamam o sistema em execução apenas
        pelo Gateway, passando por Eureka, Config Server e os microsserviços reais.
    </description>

    <properties>
        <gateway.url>http://localhost:8080</gateway.url>
        <eureka.url>http://localhost:8761</eureka.url>
    </properties>

    <dependencies>
        <!-- JUnit 5, AssertJ e JsonPath -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Os testes *IT rodam só em "mvn verify", nunca em "mvn test" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <gateway.url>${gateway.url}</gateway.url>
                        <eureka.url>${eureka.url}</eureka.url>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
